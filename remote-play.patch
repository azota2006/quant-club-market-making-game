-app.get('/api/network', async (req, res) => {
+/**
+ * The URL to put on the QR code. Over plain LAN that is a local IPv4, but
+ * behind a tunnel or a cloud host the LAN address is unreachable — what players
+ * need is the public origin their own request arrived on.
+ */
+function joinUrl(req) {
+  const configured = (process.env.PUBLIC_URL || '').trim().replace(/\/+$/, '');
+  if (configured) return { url: configured, remote: true };
+
+  const proto = String(req.headers['x-forwarded-proto'] || '').split(',')[0].trim();
+  const host = String(req.headers['x-forwarded-host'] || '').split(',')[0].trim() || req.get('host');
+  if (proto && host) return { url: `${proto}://${host}`, remote: true };
+
   const addresses = localAddresses();
   const primary = addresses.length ? addresses[0].address : 'localhost';
-  const url = `http://${primary}:${PORT}`;
+  return { url: `http://${primary}:${PORT}`, remote: false };
+}
+
+app.get('/api/network', async (req, res) => {
+  const { url, remote } = joinUrl(req);
+  // Only meaningful on a LAN; over a tunnel the extra IPs would just mislead.
+  const addresses = remote ? [] : localAddresses();
   let qr = null;
   try {
     qr = await QRCode.toDataURL(url, { margin: 1, width: 320 });
@@ -423,8 +441,11 @@ server.listen(PORT, HOST, () => {
   if (!addresses.length) {
     lines.push('  No local network address found — players must be on this machine.');
   }
+  if (process.env.PUBLIC_URL) {
+    lines.push(`  Public URL:      ${process.env.PUBLIC_URL}   (players can be on any network)`);
+  }
   lines.push('');
-  lines.push('  Everyone must be on the same WiFi. Ctrl+C to stop.');
+  lines.push('  Ctrl+C to stop.');
   lines.push('');
   console.log(lines.join('\n'));
 });
diff --git a/test/integration.test.js b/test/integration.test.js
index 993a993..2aada06 100644
--- a/test/integration.test.js
+++ b/test/integration.test.js
@@ -593,3 +593,49 @@ test('a 20-player table deals, quotes and trades without dropping anything', asy
   assert.equal(seller.holdings.S, -19);
   assert.equal(seller.cashDelta, 219 * 19);
 });
+
+// --------------------------------------------- the join URL players get given
+
+/**
+ * The QR code is the only thing 15 phones actually use, so it has to name an
+ * address they can reach. On a LAN that is the host's IPv4; behind a tunnel or
+ * a platform proxy the LAN address is useless and the public origin is what
+ * matters.
+ */
+function network(headers) {
+  return fetch(`${baseUrl}/api/network`, { headers: headers || {} }).then((r) => r.json());
+}
+
+test('the join URL falls back to the LAN address when nothing is in front', async () => {
+  const info = await network();
+  assert.match(info.url, /^http:\/\/(\d+\.\d+\.\d+\.\d+|localhost):\d+$/);
+  assert.ok(info.qr.startsWith('data:image/png;base64,'));
+});
+
+test('a proxied request is told the public origin it arrived on, not a LAN IP', async () => {
+  const info = await network({
+    'X-Forwarded-Proto': 'https',
+    'X-Forwarded-Host': 'game.trycloudflare.com',
+  });
+  assert.equal(info.url, 'https://game.trycloudflare.com');
+  // The LAN list would only offer players addresses they cannot route to.
+  assert.deepEqual(info.addresses, []);
+});
+
+test('only the first hop of a forwarded header chain is trusted', async () => {
+  const info = await network({
+    'X-Forwarded-Proto': 'https, http',
+    'X-Forwarded-Host': 'game.trycloudflare.com, internal.lb',
+  });
+  assert.equal(info.url, 'https://game.trycloudflare.com');
+});
+
+test('PUBLIC_URL overrides everything and loses a trailing slash', async () => {
+  process.env.PUBLIC_URL = 'https://mm.ashokaquantfin.org/';
+  try {
+    const info = await network({ 'X-Forwarded-Proto': 'https', 'X-Forwarded-Host': 'ignored.example' });
+    assert.equal(info.url, 'https://mm.ashokaquantfin.org');
+  } finally {
+    delete process.env.PUBLIC_URL;
+  }
+});
